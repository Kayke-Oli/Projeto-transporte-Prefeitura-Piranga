{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar Projeto",
            "type": "shell",
            "command": "C:/mingw64/bin/g++.exe",
            "args": [
                "-std=c++17",
                "-g",
                "-Wall",
                "${workspaceFolder}/src/*.cpp",
                "${workspaceFolder}/external/sqlite/sqlite3.c",
                "-I${workspaceFolder}/external/sqlite",
                "-o",
                "${workspaceFolder}/build/app.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}