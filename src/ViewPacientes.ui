    min-height: 32px;
    border-radius: 5px;
    padding: 0 14px;
    font-weight: 600;
}
QPushButton:hover { background: #dbeafe; }
QPushButton:disabled { background: #eaecf0; color: #98a2b3; }
QPushButton#btnSalvar, QPushButton#btnAtualizar, QPushButton#btnConsultar {
    background: #1d4f91;
    color: white;
    border: 0;
}
